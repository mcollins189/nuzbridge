# Android / Gradle build output
build/
app/build/
.gradle/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# Signing material must never be committed
*.jks
*.keystore
# ...except the app's own fixed debug key, which MUST be identical across
# machines and CI or Android rejects every update as a signature conflict.
!app/nuzbridge-debug.keystore
keystore.properties

# Locally staged APKs — releases carry the binary instead, so the repo does not
# accumulate a 22 MB blob per version.
NuzBridge-*.apk
